<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="86dp"
        android:layout_height="86dp">
        <ImageView
            android:id="@+id/widget_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="kaldı"
                android:textColor="#A9C2B5"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#83D3AA"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout android:id="@+id/widget_row_1" style="@style/WidgetAppRow">
            <ImageView android:id="@+id/widget_icon_1" style="@style/WidgetAppIcon" android:contentDescription="@null" />
            <TextView android:id="@+id/widget_name_1" style="@style/WidgetAppName" />
            <TextView android:id="@+id/widget_time_1" style="@style/WidgetAppTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_row_2" style="@style/WidgetAppRow">
            <ImageView android:id="@+id/widget_icon_2" style="@style/WidgetAppIcon" android:contentDescription="@null" />
            <TextView android:id="@+id/widget_name_2" style="@style/WidgetAppName" />
            <TextView android:id="@+id/widget_time_2" style="@style/WidgetAppTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_row_3" style="@style/WidgetAppRow" android:visibility="gone">
            <ImageView android:id="@+id/widget_icon_3" style="@style/WidgetAppIcon" android:contentDescription="@null" />
            <TextView android:id="@+id/widget_name_3" style="@style/WidgetAppName" />
            <TextView android:id="@+id/widget_time_3" style="@style/WidgetAppTime" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_focus"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_focus_button"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#062419"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
