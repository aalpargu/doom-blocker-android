<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/widget_title" android:textColor="#F2F7F3" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#83D3AA" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_row_1" style="@style/WidgetAppRow">
        <ImageView android:id="@+id/widget_icon_1" style="@style/WidgetAppIcon" android:contentDescription="@null" />
        <TextView android:id="@+id/widget_name_1" style="@style/WidgetAppName" />
        <TextView android:id="@+id/widget_time_1" style="@style/WidgetAppTime" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row_2" style="@style/WidgetAppRow">
        <ImageView android:id="@+id/widget_icon_2" style="@style/WidgetAppIcon" android:contentDescription="@null" />
        <TextView android:id="@+id/widget_name_2" style="@style/WidgetAppName" />
        <TextView android:id="@+id/widget_time_2" style="@style/WidgetAppTime" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row_3" style="@style/WidgetAppRow">
        <ImageView android:id="@+id/widget_icon_3" style="@style/WidgetAppIcon" android:contentDescription="@null" />
        <TextView android:id="@+id/widget_name_3" style="@style/WidgetAppName" />
        <TextView android:id="@+id/widget_time_3" style="@style/WidgetAppTime" />
    </LinearLayout>
</LinearLayout>
